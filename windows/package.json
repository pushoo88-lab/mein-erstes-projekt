{
  "name": "rechenwiese-windows",
  "productName": "Rechenwiese",
  "version": "1.0.0",
  "private": true,
  "description": "Rechenwiese als Windows-Programm (Electron)",
  "author": "Rechenwiese",
  "main": "main.js",
  "scripts": {
    "build:web": "node ../app/scripts/build-web.mjs www",
    "start": "npm run build:web && electron .",
    "selbsttest": "npm run build:web && electron . --selbsttest",
    "dist": "npm run build:web && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "de.rechenwiese.app",
    "productName": "Rechenwiese",
    "files": ["main.js", "www/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rechenwiese",
      "artifactName": "Rechenwiese-Setup.exe",
      "language": "1031"
    }
  }
}
